#!/usr/bin/env bash
set -u
# ============================================================================
# yt-dlp wrapper
#
# Commands:
#
#   yt URL [URL ...]
#       Download video
#
#   ytmp3 URL [URL ...]
#       Download audio as MP3
#
#   yt --version
#       Show yt-dlc version
#
#   yt --show-config
#       Show current configuration
#
#   yt --configure
#       Configure the wrapper
#
# Wrapper options:
#
#   --ignore-errors
#       Continue downloading remaining URLs after a failure.
#
#   --version
#       Show yt-dlc version.
#
#   --show-config
#       Show current configuration.
#
#   --configure
#       Configure the wrapper.
#
#   --help
#       Show this help.
#
# yt-dlp options:
#
#   Long-form yt-dlp options are passed through.
#   User-supplied options are placed after yt-dlc defaults so that explicit
#   user choices override compatible wrapper defaults.
#
#   Short-form yt-dlp options are intentionally rejected. This avoids
#   ambiguity with 11-character YouTube video IDs.
#
# Batch behavior:
#
#   Multiple separate inputs receive an automatic 2-5 second randomized delay
#   between downloads. This is intentionally not configurable.
#
# Configuration:
#
#   ~/.config/yt-dlc/config
#
# Temporary files:
#
#   ~/.cache/yt-dlc/tmp
#
# yt-dlp:
#
#   ~/.local/bin/yt-dlp
# ============================================================================
# ============================================================================
# Version
# ============================================================================
YT_DLC_VERSION="0.1.0"
# ============================================================================
# Paths
# ============================================================================

CONFIG_DIR="$HOME/.config/yt-dlc"
CONFIG_FILE="$CONFIG_DIR/config"

CACHE_DIR="$HOME/.cache/yt-dlc"
TMP_DIR="$CACHE_DIR/tmp"

YT_DLP="$HOME/.local/bin/yt-dlp"
# ============================================================================
# Defaults
# ============================================================================

VIDEO_DIR=""
MUSIC_DIR=""

TRANSCRIPTS="no"
TRANSCRIPT_LANG="en"

OVERWRITE="no"
# ============================================================================
# Runtime state
# ============================================================================

MODE="video"

IGNORE_ERRORS="no"
TRANSCRIPT_OVERRIDE=""
USER_YTDLP_ARGS=()
URL_INPUTS=()
URLS=()

USER_EXTRACTOR_ARGS="no"

SUCCESSFUL=0
FAILED=0
FAILED_URLS=()

CONFIG_SYNTAX_ERROR="no"
# ============================================================================
# Utility functions
# ============================================================================

show_version() {
    echo "yt-dlc $YT_DLC_VERSION"
}


strip_quotes() {
    local value="$1"

    if [[ "$value" == \"*\" && "$value" == *\" ]]; then
        value="${value:1:${#value}-2}"
    elif [[ "$value" == \'*\' && "$value" == *\' ]]; then
        value="${value:1:${#value}-2}"
    fi

    printf '%s' "$value"
}


ensure_directories() {
    mkdir -p "$CONFIG_DIR"
    mkdir -p "$TMP_DIR"
}


load_config() {
    CONFIG_SYNTAX_ERROR="no"

    if [[ ! -f "$CONFIG_FILE" ]]; then
        return 0
    fi

    # Check syntax before sourcing so a malformed configuration does not leave
    # the wrapper with partially loaded settings.
    if ! bash -n "$CONFIG_FILE" 2>/dev/null; then
        CONFIG_SYNTAX_ERROR="yes"
        return 0
    fi

    # shellcheck disable=SC1090
    source "$CONFIG_FILE"

    VIDEO_DIR="${VIDEO_DIR:-}"
    MUSIC_DIR="${MUSIC_DIR:-}"

    TRANSCRIPTS="${TRANSCRIPTS:-no}"
    TRANSCRIPT_LANG="${TRANSCRIPT_LANG:-en}"

    OVERWRITE="${OVERWRITE:-no}"

    VIDEO_DIR="$(strip_quotes "$VIDEO_DIR")"
    MUSIC_DIR="$(strip_quotes "$MUSIC_DIR")"
    TRANSCRIPT_LANG="$(strip_quotes "$TRANSCRIPT_LANG")"
}


save_config() {
    ensure_directories

    cat > "$CONFIG_FILE" <<EOF
VIDEO_DIR=$(printf '%q' "$VIDEO_DIR")
MUSIC_DIR=$(printf '%q' "$MUSIC_DIR")

TRANSCRIPTS=$(printf '%q' "$TRANSCRIPTS")
TRANSCRIPT_LANG=$(printf '%q' "$TRANSCRIPT_LANG")

OVERWRITE=$(printf '%q' "$OVERWRITE")
EOF
}
# ============================================================================
# Configuration validation
# ============================================================================

validate_directory_setting() {
    local name="$1"
    local value="$2"
    local parent

    [[ -z "$value" ]] && return 0

    if [[ -e "$value" ]]; then
        if [[ ! -d "$value" ]]; then
            echo "❌ $name is not a directory:"
            echo "   $value"
            return 1
        fi

        if [[ ! -w "$value" ]]; then
            echo "❌ $name is not writable:"
            echo "   $value"
            return 1
        fi

        return 0
    fi

    parent="$value"

    while [[ ! -e "$parent" && "$parent" != "/" ]]; do
        parent="$(dirname "$parent")"
    done

    if [[ ! -d "$parent" ]]; then
        echo "❌ Cannot determine a valid parent directory for $name:"
        echo "   $value"
        return 1
    fi

    if [[ ! -w "$parent" ]]; then
        echo "❌ Parent directory for $name is not writable:"
        echo "   $parent"
        return 1
    fi

    return 0
}


validate_config() {
    local valid="yes"

    echo
    echo "Configuration validation"
    echo "------------------------"

    if [[ "$CONFIG_SYNTAX_ERROR" == "yes" ]]; then
        echo "❌ Configuration file contains invalid Bash syntax:"
        echo "   $CONFIG_FILE"
        valid="no"
    fi

    case "$TRANSCRIPTS" in
        yes|no)
            ;;
        *)
            echo "❌ TRANSCRIPTS must be 'yes' or 'no'."
            echo "   Current value: $TRANSCRIPTS"
            valid="no"
            ;;
    esac

    if [[ -z "$TRANSCRIPT_LANG" ]]; then
        echo "❌ TRANSCRIPT_LANG must not be empty."
        valid="no"
    elif [[ ! "$TRANSCRIPT_LANG" =~ ^[A-Za-z0-9_-]+$ ]]; then
        echo "❌ TRANSCRIPT_LANG contains invalid characters."
        echo "   Current value: $TRANSCRIPT_LANG"
        echo "   Expected a language code such as: en, hu, en-US"
        valid="no"
    fi

    case "$OVERWRITE" in
        yes|no)
            ;;
        *)
            echo "❌ OVERWRITE must be 'yes' or 'no'."
            echo "   Current value: $OVERWRITE"
            valid="no"
            ;;
    esac

    if ! validate_directory_setting "VIDEO_DIR" "$VIDEO_DIR"; then
        valid="no"
    fi

    if ! validate_directory_setting "MUSIC_DIR" "$MUSIC_DIR"; then
        valid="no"
    fi

    if [[ "$valid" == "yes" ]]; then
        echo "✅ Configuration is valid."
        return 0
    fi

    echo
    echo "⚠️ Configuration is invalid."
    return 1
}


require_valid_config() {
    if ! validate_config; then
        echo
        echo "Run:"
        echo "  yt --configure"
        echo
        echo "to repair the configuration."
        return 1
    fi

    return 0
}

# ============================================================================
# Configuration reset
# ============================================================================

reset_config() {
    echo
    echo "⚠️ Reset yt-dlc configuration to defaults?"
    echo

    if ! ask_yes_no "Continue?" "no"; then
        echo
        echo "Reset cancelled."
        return 0
    fi

    VIDEO_DIR=""
    MUSIC_DIR=""

    TRANSCRIPTS="no"
    TRANSCRIPT_LANG="en"

    OVERWRITE="no"

    save_config

    echo
    echo "Configuration reset to defaults."
    echo
    echo "Configuration saved to:"
    echo "  $CONFIG_FILE"

    show_config
}

# ============================================================================
# Configuration display
# ============================================================================

show_config() {
    echo
    echo "Current download preferences"
    echo "-----------------------------"

    if [[ -n "$VIDEO_DIR" ]]; then
        echo "  Video directory:        $VIDEO_DIR"
    else
        echo "  Video directory:        current directory"
    fi

    if [[ -n "$MUSIC_DIR" ]]; then
        echo "  Music directory:        $MUSIC_DIR"
    else
        echo "  Music directory:        current directory"
    fi

    if [[ "$TRANSCRIPTS" == "yes" ]]; then
        echo "  Transcripts:             Yes ($TRANSCRIPT_LANG)"
    else
        echo "  Transcripts:             No"
    fi

    if [[ "$OVERWRITE" == "yes" ]]; then
        echo "  Overwrite files:         Yes"
    else
        echo "  Overwrite files:         No"
    fi

    echo "  Temporary files:         $TMP_DIR"
    echo

    validate_config
}
# ============================================================================
# Help
# ============================================================================

show_help() {
    echo
    echo "Usage:"
    echo "  yt [OPTIONS] URL [URL ...]"
    echo "  ytmp3 [OPTIONS] URL [URL ...]"
    echo
    echo "yt-dlc options:"
    echo "  --ignore-errors       Continue after failed downloads"
    echo "  --version             Show yt-dlc version"
    echo "  --show-config         Show current configuration"
    echo "  --configure           Configure the wrapper"
    echo "  --reset-config        Reset configuration to defaults"
    echo "  --transcript          Enable transcript for this command"
    echo "  --no-transcript       Disable transcript for this command"
    echo "  --help                Show this help"
    echo
    echo "Supported yt-dlp interface:"
    echo "  Long-form yt-dlp options may be passed through."
    echo "  User-supplied options override compatible yt-dlc defaults."
    echo
    echo "Examples:"
    echo "  yt --playlist-end 20 PLAYLIST_URL"
    echo "  yt --playlist-items 1,3,5 PLAYLIST_URL"
    echo "  yt --geo-bypass-country US VIDEO_URL"
    echo "  yt --sleep-interval 5 VIDEO_URL"
    echo "  yt --format 'bestvideo[height<=1080]+bestaudio/best' VIDEO_URL"
    echo "  yt --output '/tmp/%(title)s.%(ext)s' VIDEO_URL"
    echo
    echo "Short yt-dlp options are intentionally not accepted."
    echo "Use the long form instead:"
    echo "  --format instead of -f"
    echo "  --output instead of -o"
    echo "  --playlist-items instead of -I"
    echo
    echo "URLs may be:"
    echo "  dQw4w9WgXcQ"
    echo "  youtu.be/dQw4w9WgXcQ"
    echo "  https://youtu.be/dQw4w9WgXcQ"
    echo
    echo "Multiple inputs may be separated by spaces, commas, or semicolons:"
    echo "  yt dQw4w9WgXcQ BaW_jOozKJk"
    echo "  yt dQw4w9WgXcQ,BaW_jOozKJk"
    echo "  yt 'dQw4w9WgXcQ;BaW_jOozKJk'"
    echo
    echo "Batch downloads automatically wait 2-5 seconds between inputs."
    echo
    echo "Note:"
    echo "  --batch-file is intentionally not supported; pass multiple URLs directly."
    echo
}
# ============================================================================
# Interactive configuration
# ============================================================================

ask_yes_no() {
    local prompt="$1"
    local current="$2"
    local answer

    if [[ "$current" == "yes" ]]; then
        prompt="$prompt [Y/n]"
    else
        prompt="$prompt [y/N]"
    fi

    read -r -p "$prompt " answer || return 1

    answer="${answer:-}"

    if [[ -z "$answer" ]]; then
        [[ "$current" == "yes" ]]
        return
    fi

    case "$answer" in
        y|Y|yes|YES|Yes)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}


configure() {
    echo
    echo "🎵 yt-dlc configuration"
    echo

    echo "Download directories"
    echo "--------------------"
    echo

    if ask_yes_no "Configure download directories?" "yes"; then
        read -e -r -p \
            "Video directory [${VIDEO_DIR:-current directory}]: " \
            answer || return 1

        if [[ -n "$answer" ]]; then
            VIDEO_DIR="$(strip_quotes "$answer")"
        fi

        read -e -r -p \
            "Music directory [${MUSIC_DIR:-current directory}]: " \
            answer || return 1

        if [[ -n "$answer" ]]; then
            MUSIC_DIR="$(strip_quotes "$answer")"
        fi
    fi

    echo

    echo "Transcripts"
    echo "-----------"

    if ask_yes_no "Download video transcripts?" "$TRANSCRIPTS"; then
        TRANSCRIPTS="yes"

        read -e -r -p \
            "Transcript language [$TRANSCRIPT_LANG]: " \
            answer || return 1

        if [[ -n "$answer" ]]; then
            TRANSCRIPT_LANG="$(strip_quotes "$answer")"
        fi
    else
        TRANSCRIPTS="no"
    fi

    echo

    if ask_yes_no "Overwrite existing files?" "$OVERWRITE"; then
        OVERWRITE="yes"
    else
        OVERWRITE="no"
    fi

    echo

    save_config

    echo "Configuration saved to:"
    echo "  $CONFIG_FILE"

    show_config
}
# ============================================================================
# VTT -> TXT conversion
# ============================================================================

vtt_to_txt() {
    local input="$1"
    local output="$2"

    awk '
        BEGIN {
            IGNORECASE = 1
            previous = ""
        }

        /^WEBVTT/ {
            next
        }

        /^Kind:/ {
            next
        }

        /^Language:/ {
            next
        }

        /^NOTE([[:space:]]|$)/ {
            in_note = 1
            next
        }

        in_note {
            if ($0 == "") {
                in_note = 0
            }
            next
        }

        /^[[:space:]]*[0-9]+$/ {
            next
        }

        /-->[[:space:]]/ {
            next
        }

        /^[[:space:]]*$/ {
            next
        }

        {
            gsub(/<[^>]*>/, "", $0)
            gsub(/&amp;/,  "\\&", $0)
            gsub(/&lt;/,   "<",   $0)
            gsub(/&gt;/,   ">",   $0)
            gsub(/&quot;/, "\"",  $0)
            gsub(/&#39;/,  "\047", $0)

            if ($0 != previous) {
                print
                previous = $0
            }
        }
    ' "$input" > "$output"
}
# ============================================================================
# Select a subtitle language from yt-dlp --list-subs output
#
# Arguments:
#   $1 = captured --list-subs output
#   $2 = section: "uploaded" or "auto"
#
# Selection priority:
#   1. configured transcript language
#   2. English
#   3. first available language
#
# This intentionally selects only ONE language. The wrapper must never use
# --sub-langs all for its "find any transcript" fallback because that can
# trigger a very large number of subtitle requests and HTTP 429 responses.
# ============================================================================

select_subtitle_language() {
    local listing="$1"
    local section="$2"

    printf '%s\n' "$listing" | awk \
        -v section="$section" \
        -v target="$TRANSCRIPT_LANG" '
        BEGIN {
            active = 0
            found_target = ""
            found_english = ""
            first = ""
        }

        /Available subtitles for/ {
            active = (section == "uploaded")
            next
        }

        /Available automatic captions for/ {
            active = (section == "auto")
            next
        }

        active &&
        /^[[:space:]]*[A-Za-z0-9][A-Za-z0-9_-]*[[:space:]]+/ {

            lang = $1

            # Skip the table header.
            if (lang == "Language") {
                next
            }

            # Only accept actual subtitle rows. This prevents lines such as
            # "VIDEO_ID has no subtitles" from being treated as a language.
            if ($0 !~ /[[:space:]](vtt|srt|ttml|srv3|srv2|srv1|json3)([[:space:]]|$)/) {
                next
            }

            if (first == "") {
                first = lang
            }

            if (lang == target && found_target == "") {
                found_target = lang
            }

            if (lang == "en" && found_english == "") {
                found_english = lang
            }
        }

        END {
            if (found_target != "") {
                print found_target
            } else if (found_english != "") {
                print found_english
            } else if (first != "") {
                print first
            }
        }
    '
}
# ============================================================================
# Find a VTT belonging to a specific subtitle language
#
# The previous implementation searched for the newest VTT in the directory.
# That could accidentally select an unrelated existing transcript.
#
# Knowing the language lets us restrict the search to the file produced by
# the current subtitle request.
# ============================================================================

find_transcript_vtt() {
    local directory="$1"
    local language="$2"

    find "$directory" \
        -maxdepth 1 \
        -type f \
        -name "*.${language}.vtt" \
        -printf '%T@ %p\n' 2>/dev/null |
        sort -nr |
        head -n1 |
        cut -d' ' -f2-
}
# ============================================================================
# Transcript download
#
# Transcript strategy:
#
#   1. Try the configured language as an uploaded subtitle.
#   2. Discover available subtitles with --list-subs.
#   3. If another uploaded subtitle exists, select ONE language and try it.
#   4. If no uploaded subtitle exists, select ONE automatic caption language.
#   5. Convert the resulting VTT to TXT.
#
# Important:
#
#   --sub-langs all is deliberately NOT used here.
#
#   yt-dlp's --sub-langs all can cause a large number of subtitle downloads.
#   On YouTube this can result in HTTP 429 responses before the useful
#   transcript is ever downloaded.
# ============================================================================

download_transcript() {
    local url="$1"
    local output_dir="$2"

    [[ "$TRANSCRIPTS" == "yes" ]] || return 0

    echo
    echo "📝 Downloading transcript..."

    local output_template
    local transcript_file
    local txt_file
    local status
    local listing
    local selected_lang

    output_template="$output_dir/%(title)s [%(id)s].%(ext)s"

    # ------------------------------------------------------------------------
    # First attempt: configured language, uploaded subtitles
    # ------------------------------------------------------------------------

    "$YT_DLP" \
        --skip-download \
        --write-subs \
        --sub-langs "$TRANSCRIPT_LANG" \
        --sub-format vtt \
        --no-warnings \
        --output "$output_template" \
        "$url"

    status=$?

    transcript_file="$(find_transcript_vtt \
        "$output_dir" \
        "$TRANSCRIPT_LANG")"

    if [[ "$status" -eq 0 &&
          -n "$transcript_file" &&
          -f "$transcript_file" ]]; then

        txt_file="${transcript_file%.${TRANSCRIPT_LANG}.vtt}.txt"

        if vtt_to_txt "$transcript_file" "$txt_file"; then
            rm -f "$transcript_file"
            echo "✅ Transcript downloaded ($TRANSCRIPT_LANG)."
            return 0
        fi
    fi

    echo "ℹ️ Transcript language '$TRANSCRIPT_LANG' unavailable."
    echo "▶ Checking available subtitles..."

    # ------------------------------------------------------------------------
    # Discover available uploaded and automatic subtitles once.
    #
    # --list-subs does not download the subtitle files. It gives us the
    # available language lists so that we can select exactly one language.
    # ------------------------------------------------------------------------

    listing="$("$YT_DLP" \
        --list-subs \
        --no-warnings \
        "$url" 2>&1)"

    # ------------------------------------------------------------------------
    # Uploaded subtitle fallback
    # ------------------------------------------------------------------------

    selected_lang="$(select_subtitle_language "$listing" "uploaded")"

    if [[ -n "$selected_lang" ]]; then
        echo "▶ Trying uploaded subtitle: $selected_lang"

        "$YT_DLP" \
            --skip-download \
            --write-subs \
            --sub-langs "$selected_lang" \
            --sub-format vtt \
            --no-warnings \
            --output "$output_template" \
            "$url"

        status=$?

        transcript_file="$(find_transcript_vtt \
            "$output_dir" \
            "$selected_lang")"

        if [[ "$status" -eq 0 &&
              -n "$transcript_file" &&
              -f "$transcript_file" ]]; then

            txt_file="${transcript_file%.${selected_lang}.vtt}.txt"

            if vtt_to_txt "$transcript_file" "$txt_file"; then
                rm -f "$transcript_file"
                echo "✅ Transcript downloaded ($selected_lang)."
                return 0
            fi
        fi
    fi

    echo "ℹ️ No usable uploaded subtitle available."
    echo "▶ Trying automatically generated subtitle..."

    # ------------------------------------------------------------------------
    # Automatic caption fallback
    # ------------------------------------------------------------------------

    selected_lang="$(select_subtitle_language "$listing" "auto")"

    if [[ -z "$selected_lang" ]]; then
        echo "ℹ️ No automatically generated subtitle available."
        echo "ℹ️ No transcript was downloaded."
        return 0
    fi

    echo "▶ Trying automatically generated subtitle: $selected_lang"

    "$YT_DLP" \
        --skip-download \
        --write-auto-subs \
        --sub-langs "$selected_lang" \
        --sub-format vtt \
        --no-warnings \
        --output "$output_template" \
        "$url"

    status=$?

    transcript_file="$(find_transcript_vtt \
        "$output_dir" \
        "$selected_lang")"

    if [[ "$status" -eq 0 &&
          -n "$transcript_file" &&
          -f "$transcript_file" ]]; then

        txt_file="${transcript_file%.${selected_lang}.vtt}.txt"

        if vtt_to_txt "$transcript_file" "$txt_file"; then
            rm -f "$transcript_file"
            echo "✅ Transcript downloaded ($selected_lang)."
            return 0
        fi
    fi

    echo "ℹ️ No transcript was downloaded."

    return 0
}
# ============================================================================
# yt-dlp update check
# ============================================================================

check_update() {
    echo "Checking for a newer yt-dlp version..."

    "$YT_DLP" -U

    echo
}
# ============================================================================
# yt-dlp option handling
#
# We intentionally accept long-form yt-dlp options rather than maintaining a
# complete copy of yt-dlp's CLI.
#
# The value-taking list exists only because the wrapper needs to know when the
# following argument belongs to an option rather than being another URL.
#
# yt-dlp is a large and evolving CLI, so this list should contain options
# whose separate values can plausibly look like URLs or YouTube IDs.
# ============================================================================

option_takes_value() {
    local option="$1"

    case "$option" in

        # Video selection / format
        --format|--format-sort|--output-format|--merge-output-format)
            return 0
            ;;

        # Output
        --output|--paths|--output-na-placeholder)
            return 0
            ;;

        # Playlist
        --playlist-start|--playlist-end|--playlist-items)
            return 0
            ;;

        # Geo / networking
        --geo-bypass-country|--geo-bypass-ip-block|\
        --geo-verification-proxy|--proxy|--referer|\
        --source-address|--socket-timeout)
            return 0
            ;;

        # Download timing / rate
        --sleep-interval|--max-sleep-interval|\
        --min-sleep-interval|--sleep-requests|\
        --limit-rate|--throttled-rate|--retries)
            return 0
            ;;

        # Authentication / cookies
        --cookies|--cookies-from-browser|\
        --username|--password|--twofactor)
            return 0
            ;;

        # HTTP
        --user-agent|--add-header|--impersonate)
            return 0
            ;;

        # Subtitles
        --sub-langs|--sub-format)
            return 0
            ;;

        # Audio
        --audio-format|--audio-quality)
            return 0
            ;;

        # Extractor
        --extractor-args|--use-extractors)
            return 0
            ;;

        # External tools
        --ffmpeg-location|--exec|--exec-before-download|\
        --downloader|--downloader-args)
            return 0
            ;;

        # Metadata / filtering
        --match-filter|--dateafter|--datebefore|\
        --playlist-reverse|--playlist-random)
            return 0
            ;;

        *)
            return 1
            ;;

    esac
}
# ============================================================================
# Wrapper-owned options
#
# These must never be forwarded to yt-dlp.
# ============================================================================

is_wrapper_option() {
    case "$1" in
        --ignore-errors|--version|--show-config|--configure|--reset-config|\
        --transcript|--no-transcript|--help)
            return 0
            ;;

        *)
            return 1
            ;;
    esac
}

# ============================================================================
# yt-dlp options that would conflict with wrapper-owned behavior
#
# We don't silently override these. Instead, the wrapper tells the user why
# the option is unavailable.
# ============================================================================

is_blocked_option() {
    local option="$1"

    case "$option" in
        --batch-file|--no-batch-file)
            return 0
            ;;

        --update|--no-update)
            return 0
            ;;

        --help)
            return 0
            ;;

        --ignore-errors)
            return 0
            ;;

        *)
            return 1
            ;;
    esac
}
# ============================================================================
# Build common yt-dlp arguments
#
# User arguments are appended later and therefore take precedence over
# compatible defaults.
# ============================================================================

build_common_args() {
    args=()

    if [[ "$MODE" == "mp3" ]]; then
        if [[ -n "$MUSIC_DIR" ]]; then
            args+=(--paths "$MUSIC_DIR")
        fi
    else
        if [[ -n "$VIDEO_DIR" ]]; then
            args+=(--paths "$VIDEO_DIR")
        fi
    fi

    args+=(--paths "temp:$TMP_DIR")

    args+=(
        --output "%(title)s [%(id)s].%(ext)s"
    )

    if [[ "$OVERWRITE" == "yes" ]]; then
        args+=(--force-overwrites)
    else
        args+=(--no-overwrites)
    fi

    if [[ "$MODE" == "video" ]]; then
        args+=(
            --format "bestvideo*+bestaudio/best"
            --merge-output-format mp4
        )

    elif [[ "$MODE" == "mp3" ]]; then
        args+=(
            --format "bestaudio/best"
            --extract-audio
            --audio-format mp3
            --audio-quality 0
        )
    fi
}
# ============================================================================
# Download one URL
# ============================================================================

download() {
    local url="$1"
    local output_dir

    if [[ "$MODE" == "mp3" ]]; then
        output_dir="${MUSIC_DIR:-$(pwd)}"
    else
        output_dir="${VIDEO_DIR:-$(pwd)}"
    fi

    mkdir -p "$output_dir"

    build_common_args

    echo "▶ Downloading..."

    "$YT_DLP" \
        "${args[@]}" \
        "${USER_YTDLP_ARGS[@]}" \
        "$url"

    local status=$?

    if [[ "$status" -eq 0 ]]; then
        download_transcript "$url" "$output_dir"
        return 0
    fi

    echo
    echo "⚠️ Download failed."

    check_update

    echo "▶ Retrying..."
    echo

    "$YT_DLP" \
        "${args[@]}" \
        "${USER_YTDLP_ARGS[@]}" \
        "$url"

    status=$?

    if [[ "$status" -eq 0 ]]; then
        download_transcript "$url" "$output_dir"
        return 0
    fi

    echo
    echo "⚠️ Standard retry failed."

    if [[ "$USER_EXTRACTOR_ARGS" == "yes" ]]; then
        echo "ℹ️ Skipping web-client fallback because --extractor-args was supplied."
        echo
        echo "❌ Download failed."
        return "$status"
    fi

    echo "▶ Retrying with the YouTube web client..."
    echo

    "$YT_DLP" \
        --extractor-args "youtube:player_client=web" \
        "${args[@]}" \
        "${USER_YTDLP_ARGS[@]}" \
        "$url"

    status=$?

    if [[ "$status" -eq 0 ]]; then
        download_transcript "$url" "$output_dir"
        return 0
    fi

    echo
    echo "❌ Download failed."

    return "$status"
}
# ============================================================================
# Automatic batch delay
#
# 2-5 seconds is deliberately used instead of a fixed delay. It is enough to
# avoid hammering requests in a batch without making ordinary small batches
# unnecessarily slow.
# ============================================================================

batch_delay() {
    local current_index="$1"
    local total="$2"

    if (( total <= 1 || current_index >= total )); then
        return 0
    fi

    local delay=$(( RANDOM % 4 + 2 ))

    echo
    echo "⏳ Waiting ${delay}s before the next download..."
    sleep "$delay"
}
# ============================================================================
# Determine mode
# ============================================================================

if [[ "${1:-}" == "video" || "${1:-}" == "mp3" ]]; then
    MODE="$1"
    shift
fi

if [[ "$#" -eq 0 ]]; then
    show_help
    exit 1
fi
# ============================================================================
# Argument parsing
#
# IMPORTANT:
#
# Wrapper commands are checked BEFORE YouTube-ID detection.
#
# This prevents:
#
#   --configure
#
# from being interpreted as an 11-character YouTube ID.
# ============================================================================

EXPECTING_OPTION_VALUE="no"
CURRENT_OPTION=""

for arg in "$@"; do

    # ------------------------------------------------------------------------
    # Value belonging to previous yt-dlp option
    # ------------------------------------------------------------------------

    if [[ "$EXPECTING_OPTION_VALUE" == "yes" ]]; then
        USER_YTDLP_ARGS+=("$arg")
        EXPECTING_OPTION_VALUE="no"
        CURRENT_OPTION=""
        continue
    fi

    # ------------------------------------------------------------------------
    # Wrapper-owned commands first
    # ------------------------------------------------------------------------

    case "$arg" in

        --ignore-errors)
            IGNORE_ERRORS="yes"
            continue
            ;;

        --transcript)
            TRANSCRIPT_OVERRIDE="yes"
            continue
            ;;

        --no-transcript)
            TRANSCRIPT_OVERRIDE="no"
            continue
            ;;

        --version)
            show_version
            exit 0
            ;;

        --show-config)
            load_config
            show_config
            exit 0
            ;;

        --configure)
            load_config
            configure
            exit 0
            ;;

	--reset-config)
            reset_config
            exit 0
            ;;

        --help)
            show_help
            exit 0
            ;;

    esac

    # ------------------------------------------------------------------------
    # Explicit end-of-options marker
    # ------------------------------------------------------------------------

    if [[ "$arg" == "--" ]]; then
        USER_YTDLP_ARGS+=("$arg")
        continue
    fi

    # ------------------------------------------------------------------------
    # Bare YouTube video ID
    #
    # This intentionally occurs before generic "-" handling.
    #
    # Valid IDs may begin with '-' or contain '-'.
    # ------------------------------------------------------------------------

    if [[ "$arg" =~ ^[A-Za-z0-9_-]{11}$ ]]; then
        URL_INPUTS+=("$arg")
        continue
    fi

    # ------------------------------------------------------------------------
    # Long-form yt-dlp option
    # ------------------------------------------------------------------------

    if [[ "$arg" == --* ]]; then

        if is_blocked_option "$arg"; then
            echo "❌ Option '$arg' is controlled by yt-dlc and cannot be passed through."
            exit 1
        fi

        USER_YTDLP_ARGS+=("$arg")

        # --option=value already contains its value.
        if [[ "$arg" == *=* ]]; then
            EXPECTING_OPTION_VALUE="no"
            CURRENT_OPTION=""

        else
            if option_takes_value "$arg"; then
                EXPECTING_OPTION_VALUE="yes"
                CURRENT_OPTION="$arg"
            else
                EXPECTING_OPTION_VALUE="no"
                CURRENT_OPTION=""
            fi
        fi

        if [[ "$arg" == "--extractor-args" ||
              "$arg" == --extractor-args=* ]]; then
            USER_EXTRACTOR_ARGS="yes"
        fi

        continue
    fi

    # ------------------------------------------------------------------------
    # Short options are intentionally rejected.
    #
    # This is important because YouTube IDs may contain '-'.
    # ------------------------------------------------------------------------

    if [[ "$arg" == -* ]]; then
        echo "❌ Short options are not accepted by yt-dlc: $arg"
        echo
        echo "Use the long yt-dlp form instead."
        echo
        echo "Examples:"
        echo "  -f  → --format"
        echo "  -o  → --output"
        echo "  -I  → --playlist-items"
        echo
        exit 1
    fi

    # ------------------------------------------------------------------------
    # URLs
    # ------------------------------------------------------------------------

    if [[ "$arg" =~ ^https?:// ||
          "$arg" =~ ^youtu\.be/ ]]; then

        URL_INPUTS+=("$arg")
        continue
    fi

    # ------------------------------------------------------------------------
    # Anything else at this point is invalid.
    #
    # We do NOT silently treat arbitrary text as a yt-dlp value because doing
    # so makes malformed commands surprisingly dangerous.
    # ------------------------------------------------------------------------

    echo "❌ Invalid input: $arg"
    echo
    echo "Expected a URL, YouTube video ID, or long-form yt-dlp option."
    exit 1

done
# ============================================================================
# Load and validate configuration
# ============================================================================

load_config

if [[ "$CONFIG_SYNTAX_ERROR" == "no" ]]; then
    ensure_directories
fi

# Command-line transcript selection overrides the persistent configuration
# for this invocation only.
if [[ "$TRANSCRIPT_OVERRIDE" == "yes" ]]; then
    TRANSCRIPTS="yes"
elif [[ "$TRANSCRIPT_OVERRIDE" == "no" ]]; then
    TRANSCRIPTS="no"
fi

if ! require_valid_config; then
    exit 1
fi
# ============================================================================
# Normalize URL inputs
# ============================================================================

URLS=()

for input in "${URL_INPUTS[@]}"; do

    input="${input//,/ }"
    input="${input//;/ }"

    read -r -a parts <<< "$input"

    for part in "${parts[@]}"; do

        [[ -z "$part" ]] && continue

        if [[ "$part" =~ ^[A-Za-z0-9_-]{11}$ ]]; then
            URLS+=("https://youtu.be/$part")
            continue
        fi

        if [[ "$part" =~ ^youtu\.be/([A-Za-z0-9_-]{11})$ ]]; then
            URLS+=("https://$part")
            continue
        fi

        if [[ "$part" =~ ^https?://youtu\.be/([A-Za-z0-9_-]{11}) ]]; then
            URLS+=("$part")
            continue
        fi

        if [[ "$part" =~ ^https?:// ]]; then
            URLS+=("$part")
            continue
        fi

        echo "⚠️ Ignoring invalid URL/input: $part"

    done

done
# ============================================================================
# Validate URLs
# ============================================================================

if [[ "${#URLS[@]}" -eq 0 ]]; then
    echo
    echo "❌ No valid URLs specified."
    echo
    show_help
    exit 1
fi
# ============================================================================
# Execute batch
# ============================================================================

TOTAL="${#URLS[@]}"

for (( INDEX=0; INDEX<TOTAL; INDEX++ )); do

    URL="${URLS[$INDEX]}"

    echo
    echo "▶ Downloading: $URL"

    if download "$URL"; then

        SUCCESSFUL=$((SUCCESSFUL + 1))

    else

        FAILED=$((FAILED + 1))
        FAILED_URLS+=("$URL")

        if [[ "$IGNORE_ERRORS" == "yes" ]]; then
            echo "⚠️ Download failed."
            echo "ℹ️ Ignoring error and continuing..."

        else
            echo
            echo "❌ Download failed: $URL"
            echo
            echo "⚠️ Batch stopped because --ignore-errors was not specified."

            exit 1
        fi
    fi

    if (( INDEX + 1 < TOTAL )); then
        batch_delay "$((INDEX + 1))" "$TOTAL"
    fi

done
# ============================================================================
# Batch summary
# ============================================================================

echo
echo "────────────────────────────────────────"
echo "Batch completed."

printf '   Successful: %d\n' "$SUCCESSFUL"
printf '   Failed:     %d\n' "$FAILED"

if [[ "$FAILED" -gt 0 ]]; then

    echo
    echo "Failed URLs:"

    for URL in "${FAILED_URLS[@]}"; do
        echo "  - $URL"
    done

    echo
    echo "⚠️ One or more downloads failed."

    exit 1
fi

echo
echo "✅ All downloads completed successfully."

exit 0

