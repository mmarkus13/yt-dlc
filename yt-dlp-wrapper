#!/usr/bin/env bash

set -u

# ============================================================================
# yt-dlp wrapper
#
# Commands:
#
#   yt URL [URL ...]
#       Download video
#
#   ytmp3 URL [URL ...]
#       Download audio as MP3
#
#   yt --show-config
#       Show current configuration
#
#   yt --configure
#       Configure the wrapper
#
# Options:
#
#   --ignore-errors
#       Continue downloading remaining URLs after a failure.
#
# Configuration:
#
#   ~/.config/yt-dlc/config
#
# Temporary files:
#
#   ~/.cache/yt-dlc/tmp
#
# yt-dlp:
#
#   ~/.local/bin/yt-dlp
# ============================================================================


# ============================================================================
# Paths
# ============================================================================

CONFIG_DIR="$HOME/.config/yt-dlc"
CONFIG_FILE="$CONFIG_DIR/config"

CACHE_DIR="$HOME/.cache/yt-dlc"
TMP_DIR="$CACHE_DIR/tmp"

YT_DLP="$HOME/.local/bin/yt-dlp"


# ============================================================================
# Defaults
# ============================================================================

VIDEO_DIR=""
MUSIC_DIR=""

TRANSCRIPTS="no"
TRANSCRIPT_LANG="en"

OVERWRITE="no"
DOWNLOAD_DELAY=""
GEO_COUNTRY=""


# ============================================================================
# Utility functions
# ============================================================================

strip_quotes() {
    local value="$1"

    if [[ "$value" == \"*\" && "$value" == *\" ]]; then
        value="${value:1:${#value}-2}"
    elif [[ "$value" == \'*\' && "$value" == *\' ]]; then
        value="${value:1:${#value}-2}"
    fi

    printf '%s' "$value"
}


ensure_directories() {
    mkdir -p "$CONFIG_DIR"
    mkdir -p "$TMP_DIR"
}


load_config() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        return 0
    fi

    # shellcheck disable=SC1090
    source "$CONFIG_FILE"

    VIDEO_DIR="${VIDEO_DIR:-}"
    MUSIC_DIR="${MUSIC_DIR:-}"

    TRANSCRIPTS="${TRANSCRIPTS:-no}"
    TRANSCRIPT_LANG="${TRANSCRIPT_LANG:-en}"

    OVERWRITE="${OVERWRITE:-no}"
    DOWNLOAD_DELAY="${DOWNLOAD_DELAY:-}"
    GEO_COUNTRY="${GEO_COUNTRY:-}"

    VIDEO_DIR="$(strip_quotes "$VIDEO_DIR")"
    MUSIC_DIR="$(strip_quotes "$MUSIC_DIR")"
    TRANSCRIPT_LANG="$(strip_quotes "$TRANSCRIPT_LANG")"
    DOWNLOAD_DELAY="$(strip_quotes "$DOWNLOAD_DELAY")"
    GEO_COUNTRY="$(strip_quotes "$GEO_COUNTRY")"
}


save_config() {
    ensure_directories

    cat > "$CONFIG_FILE" <<EOF
VIDEO_DIR=$(printf '%q' "$VIDEO_DIR")
MUSIC_DIR=$(printf '%q' "$MUSIC_DIR")

TRANSCRIPTS=$(printf '%q' "$TRANSCRIPTS")
TRANSCRIPT_LANG=$(printf '%q' "$TRANSCRIPT_LANG")

OVERWRITE=$(printf '%q' "$OVERWRITE")
DOWNLOAD_DELAY=$(printf '%q' "$DOWNLOAD_DELAY")
GEO_COUNTRY=$(printf '%q' "$GEO_COUNTRY")
EOF
}


# ============================================================================
# Configuration display
# ============================================================================

show_config() {
    echo
    echo "Current download preferences"
    echo "-----------------------------"

    if [[ -n "$VIDEO_DIR" ]]; then
        echo "  Video directory:        $VIDEO_DIR"
    else
        echo "  Video directory:        current directory"
    fi

    if [[ -n "$MUSIC_DIR" ]]; then
        echo "  Music directory:        $MUSIC_DIR"
    else
        echo "  Music directory:        current directory"
    fi

    if [[ "$TRANSCRIPTS" == "yes" ]]; then
        echo "  Transcripts:             Yes ($TRANSCRIPT_LANG)"
    else
        echo "  Transcripts:             No"
    fi

    if [[ "$OVERWRITE" == "yes" ]]; then
        echo "  Overwrite files:         Yes"
    else
        echo "  Overwrite files:         No"
    fi

    if [[ -n "$DOWNLOAD_DELAY" ]]; then
        echo "  Download delay:          ${DOWNLOAD_DELAY}s"
    else
        echo "  Download delay:          0s"
    fi

    if [[ -n "$GEO_COUNTRY" ]]; then
        echo "  Geo country:             $GEO_COUNTRY"
    else
        echo "  Geo country:             Not specified"
    fi

    echo "  Temporary files:         $TMP_DIR"
    echo
}


# ============================================================================
# Help
# ============================================================================

show_help() {
    echo
    echo "Usage:"
    echo "  yt URL [URL ...]"
    echo "  ytmp3 URL [URL ...]"
    echo
    echo "Options:"
    echo "  --ignore-errors       Continue after failed downloads"
    echo "  --show-config         Show current configuration"
    echo "  --configure           Configure the wrapper"
    echo "  --help, -h            Show this help"
    echo
    echo "URLs may be:"
    echo "  dQw4w9WgXcQ"
    echo "  youtu.be/dQw4w9WgXcQ"
    echo "  https://youtu.be/dQw4w9WgXcQ"
    echo
    echo "Multiple URLs may be separated by spaces, commas, or semicolons:"
    echo "  yt dQw4w9WgXcQ BaW_jOozKJk"
    echo "  yt dQw4w9WgXcQ,BaW_jOozKJk"
    echo "  yt 'dQw4w9WgXcQ;BaW_jOozKJk'"
    echo
}


# ============================================================================
# Interactive configuration
# ============================================================================

ask_yes_no() {
    local prompt="$1"
    local current="$2"
    local answer

    if [[ "$current" == "yes" ]]; then
        prompt="$prompt [Y/n]"
    else
        prompt="$prompt [y/N]"
    fi

    read -r -p "$prompt " answer || return 1

    answer="${answer:-}"

    if [[ -z "$answer" ]]; then
        [[ "$current" == "yes" ]]
        return
    fi

    case "$answer" in
        y|Y|yes|YES|Yes)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}


configure() {
    echo
    echo "🎵 yt-dlc configuration"
    echo

    # ------------------------------------------------------------------------
    # Download directories
    # ------------------------------------------------------------------------

    echo "Download directories"
    echo "--------------------"
    echo

    if ask_yes_no "Configure download directories?" "yes"; then

        read -r -p \
            "Video directory [${VIDEO_DIR:-current directory}]: " \
            answer || return 1

        if [[ -n "$answer" ]]; then
            VIDEO_DIR="$(strip_quotes "$answer")"
        fi

        read -r -p \
            "Music directory [${MUSIC_DIR:-current directory}]: " \
            answer || return 1

        if [[ -n "$answer" ]]; then
            MUSIC_DIR="$(strip_quotes "$answer")"
        fi
    fi

    echo

    # ------------------------------------------------------------------------
    # Transcripts
    # ------------------------------------------------------------------------

    echo "Transcripts"
    echo "-----------"

    if ask_yes_no "Download video transcripts?" "$TRANSCRIPTS"; then
        TRANSCRIPTS="yes"

        read -r -p \
            "Transcript language [$TRANSCRIPT_LANG]: " \
            answer || return 1

        if [[ -n "$answer" ]]; then
            TRANSCRIPT_LANG="$(strip_quotes "$answer")"
        fi
    else
        TRANSCRIPTS="no"
    fi

    echo

    # ------------------------------------------------------------------------
    # Overwrite
    # ------------------------------------------------------------------------

    if ask_yes_no "Overwrite existing files?" "$OVERWRITE"; then
        OVERWRITE="yes"
    else
        OVERWRITE="no"
    fi

    echo

    # ------------------------------------------------------------------------
    # Download delay
    # ------------------------------------------------------------------------

    read -r -p \
        "Download delay in seconds [${DOWNLOAD_DELAY:-0}]: " \
        answer || return 1

    if [[ -n "$answer" ]]; then
        DOWNLOAD_DELAY="$(strip_quotes "$answer")"
    fi

    echo

    # ------------------------------------------------------------------------
    # Geo country
    # ------------------------------------------------------------------------

    read -r -p \
        "Geo country code [${GEO_COUNTRY:-none}]: " \
        answer || return 1

    if [[ -n "$answer" ]]; then
        GEO_COUNTRY="$(strip_quotes "$answer")"
    fi

    echo

    save_config

    echo "Configuration saved to:"
    echo "  $CONFIG_FILE"

    show_config
}


# ============================================================================
# VTT -> TXT conversion
# ============================================================================

vtt_to_txt() {
    local input="$1"
    local output="$2"

    awk '
        BEGIN {
            IGNORECASE = 1
            previous = ""
        }

        /^WEBVTT/ {
            next
        }

        /^Kind:/ {
            next
        }

        /^Language:/ {
            next
        }

        /^NOTE([[:space:]]|$)/ {
            in_note = 1
            next
        }

        in_note {
            if ($0 == "") {
                in_note = 0
            }
            next
        }

        /^[[:space:]]*[0-9]+$/ {
            next
        }

        /-->[[:space:]]/ {
            next
        }

        /^[[:space:]]*$/ {
            next
        }

        {
            gsub(/<[^>]*>/, "", $0)

            gsub(/&amp;/,  "\\&", $0)
            gsub(/&lt;/,   "<",   $0)
            gsub(/&gt;/,   ">",   $0)
            gsub(/&quot;/, "\"",  $0)
            gsub(/&#39;/,  "\047", $0)

            if ($0 != previous) {
                print
                previous = $0
            }
        }
    ' "$input" > "$output"
}


# ============================================================================
# Find newest VTT in a directory
# ============================================================================

find_newest_vtt() {
    local directory="$1"

    find "$directory" \
        -maxdepth 1 \
        -type f \
        -name '*.vtt' \
        -printf '%T@ %p\n' 2>/dev/null |
        sort -nr |
        head -n1 |
        cut -d' ' -f2-
}


# ============================================================================
# Transcript download
# ============================================================================

download_transcript() {
    local url="$1"
    local output_dir="$2"

    [[ "$TRANSCRIPTS" == "yes" ]] || return 0

    echo
    echo "📝 Downloading transcript..."

    local output_template
    local transcript_file
    local txt_file
    local status

    output_template="$output_dir/%(title)s [%(id)s].%(ext)s"

    # ------------------------------------------------------------------------
    # First attempt:
    #
    # Specifically configured language.
    # ------------------------------------------------------------------------

    "$YT_DLP" \
        --skip-download \
        --write-subs \
        --sub-langs "$TRANSCRIPT_LANG" \
        --sub-format vtt \
        --no-warnings \
        --output "$output_template" \
        "$url"

    status=$?

    transcript_file="$(find "$output_dir" \
        -maxdepth 1 \
        -type f \
        -name "*.${TRANSCRIPT_LANG}.vtt" \
        -printf '%T@ %p\n' 2>/dev/null |
        sort -nr |
        head -n1 |
        cut -d' ' -f2-)"

    if [[ "$status" -eq 0 &&
          -n "$transcript_file" &&
          -f "$transcript_file" ]]; then

        txt_file="${transcript_file%.${TRANSCRIPT_LANG}.vtt}.txt"

        if vtt_to_txt "$transcript_file" "$txt_file"; then
            rm -f "$transcript_file"

            echo "✅ Transcript downloaded ($TRANSCRIPT_LANG)."
            return 0
        fi
    fi

    echo "ℹ️ Transcript language '$TRANSCRIPT_LANG' unavailable."
    echo "▶ Trying any available subtitle..."

    # ------------------------------------------------------------------------
    # Second attempt:
    #
    # Any uploaded subtitle.
    # ------------------------------------------------------------------------

    "$YT_DLP" \
        --skip-download \
        --write-subs \
        --sub-langs "all" \
        --sub-format vtt \
        --no-warnings \
        --output "$output_template" \
        "$url"

    status=$?

    transcript_file="$(find_newest_vtt "$output_dir")"

    if [[ "$status" -eq 0 &&
          -n "$transcript_file" &&
          -f "$transcript_file" ]]; then

        txt_file="${transcript_file%.vtt}.txt"

        if vtt_to_txt "$transcript_file" "$txt_file"; then
            rm -f "$transcript_file"

            echo "✅ Transcript downloaded."
            return 0
        fi
    fi

    echo "ℹ️ No uploaded subtitle available."
    echo "▶ Trying any automatically generated subtitle..."

    # ------------------------------------------------------------------------
    # Third attempt:
    #
    # Any automatically generated subtitle.
    # ------------------------------------------------------------------------

    "$YT_DLP" \
        --skip-download \
        --write-auto-subs \
        --sub-langs "all" \
        --sub-format vtt \
        --no-warnings \
        --output "$output_template" \
        "$url"

    status=$?

    transcript_file="$(find_newest_vtt "$output_dir")"

    if [[ "$status" -eq 0 &&
          -n "$transcript_file" &&
          -f "$transcript_file" ]]; then

        txt_file="${transcript_file%.vtt}.txt"

        if vtt_to_txt "$transcript_file" "$txt_file"; then
            rm -f "$transcript_file"

            echo "✅ Transcript downloaded."
            return 0
        fi
    fi

    echo "ℹ️ No transcript was downloaded."

    return 0
}


# ============================================================================
# yt-dlp update check
# ============================================================================

check_update() {
    echo "Checking for a newer yt-dlp version..."

    "$YT_DLP" -U

    echo
}


# ============================================================================
# Build common yt-dlp arguments
# ============================================================================

build_common_args() {
    args=()

    # ------------------------------------------------------------------------
    # Output location
    # ------------------------------------------------------------------------

    if [[ "$MODE" == "mp3" ]]; then
        if [[ -n "$MUSIC_DIR" ]]; then
            args+=(--paths "$MUSIC_DIR")
        fi
    else
        if [[ -n "$VIDEO_DIR" ]]; then
            args+=(--paths "$VIDEO_DIR")
        fi
    fi

    # ------------------------------------------------------------------------
    # Temporary working directory
    # ------------------------------------------------------------------------

    args+=(--paths "temp:$TMP_DIR")

    # ------------------------------------------------------------------------
    # Output filename
    # ------------------------------------------------------------------------

    args+=(
        --output "%(title)s [%(id)s].%(ext)s"
    )

    # ------------------------------------------------------------------------
    # Overwrite behavior
    # ------------------------------------------------------------------------

    if [[ "$OVERWRITE" == "yes" ]]; then
        args+=(--force-overwrites)
    else
        args+=(--no-overwrites)
    fi

    # ------------------------------------------------------------------------
    # Download delay
    # ------------------------------------------------------------------------

    if [[ -n "$DOWNLOAD_DELAY" ]]; then
        args+=(--sleep-interval "$DOWNLOAD_DELAY")
    fi

    # ------------------------------------------------------------------------
    # Geo country
    # ------------------------------------------------------------------------

    if [[ -n "$GEO_COUNTRY" ]]; then
        args+=(--geo-bypass-country "$GEO_COUNTRY")
    fi

    # ------------------------------------------------------------------------
    # Video mode
    # ------------------------------------------------------------------------

    if [[ "$MODE" == "video" ]]; then

        args+=(
            --format "bestvideo*+bestaudio/best"
            --merge-output-format mp4
        )

    # ------------------------------------------------------------------------
    # MP3 mode
    # ------------------------------------------------------------------------

    elif [[ "$MODE" == "mp3" ]]; then

        args+=(
            --format "bestaudio/best"
            --extract-audio
            --audio-format mp3
            --audio-quality 0
        )
    fi
}


# ============================================================================
# Perform a single download
#
# Returns:
#
#   0  success
#   non-zero  failure
# ============================================================================

download() {
    local url="$1"
    local output_dir

    if [[ "$MODE" == "mp3" ]]; then
        output_dir="${MUSIC_DIR:-$(pwd)}"
    else
        output_dir="${VIDEO_DIR:-$(pwd)}"
    fi

    # Ensure destination exists when configured.
    if [[ -n "$output_dir" ]]; then
        mkdir -p "$output_dir"
    fi

    build_common_args

    echo "▶ Downloading..."

    "$YT_DLP" \
        "${args[@]}" \
        "$url"

    local status=$?

    if [[ "$status" -eq 0 ]]; then
        download_transcript "$url" "$output_dir"
        return 0
    fi

    echo
    echo "⚠️ Download failed."

    check_update

    echo "▶ Retrying..."
    echo

    # ------------------------------------------------------------------------
    # Standard retry
    # ------------------------------------------------------------------------

    "$YT_DLP" \
        "${args[@]}" \
        "$url"

    status=$?

    if [[ "$status" -eq 0 ]]; then
        download_transcript "$url" "$output_dir"
        return 0
    fi

    echo
    echo "⚠️ Standard retry failed."
    echo "▶ Retrying with the YouTube web client..."
    echo

    # ------------------------------------------------------------------------
    # YouTube web-client retry
    # ------------------------------------------------------------------------

    "$YT_DLP" \
        --extractor-args "youtube:player_client=web" \
        "${args[@]}" \
        "$url"

    status=$?

    if [[ "$status" -eq 0 ]]; then
        download_transcript "$url" "$output_dir"
        return 0
    fi

    echo
    echo "❌ Download failed."

    return "$status"
}


# ============================================================================
# Argument parsing
#
# Rules:
#
#   --something
#       Wrapper option
#
#   anything else
#       URL / video ID
#
# URL inputs may be separated by:
#
#   spaces
#   commas
#   semicolons
# ============================================================================

MODE="${1:-}"

if [[ "$MODE" == "video" || "$MODE" == "mp3" ]]; then
    shift
else
    MODE="video"
fi


# ============================================================================
# Wrapper options and URL collection
# ============================================================================

IGNORE_ERRORS="no"
URL_INPUTS=()


for arg in "$@"; do

    # ------------------------------------------------------------------------
    # Anything beginning with "--" is a wrapper option.
    # ------------------------------------------------------------------------

    if [[ "$arg" == --* ]]; then

        case "$arg" in

            --ignore-errors)
                IGNORE_ERRORS="yes"
                ;;

            --show-config)
                load_config
                show_config
                exit 0
                ;;

            --configure)
                load_config
                configure
                exit 0
                ;;

            --help)
                show_help
                exit 0
                ;;

            *)
                echo "❌ Unknown option: $arg"
                echo
                show_help
                exit 1
                ;;

        esac

        continue
    fi

    # ------------------------------------------------------------------------
    # Anything else is URL input.
    # ------------------------------------------------------------------------

    URL_INPUTS+=("$arg")

done


# ============================================================================
# Short help option
# ============================================================================

for arg in "${URL_INPUTS[@]}"; do
    if [[ "$arg" == "-h" ]]; then
        show_help
        exit 0
    fi
done


# ============================================================================
# Load configuration
# ============================================================================

load_config
ensure_directories


# ============================================================================
# Expand and normalize URL input
# ============================================================================

URLS=()

for input in "${URL_INPUTS[@]}"; do

    # ------------------------------------------------------------------------
    # Allow comma and semicolon delimiters inside a single argument.
    #
    # Spaces are already handled by the shell as separate arguments.
    # ------------------------------------------------------------------------

    input="${input//,/ }"
    input="${input//;/ }"

    # ------------------------------------------------------------------------
    # Split resulting string on whitespace.
    # ------------------------------------------------------------------------

    read -r -a parts <<< "$input"

    for part in "${parts[@]}"; do

        [[ -z "$part" ]] && continue

        # ------------------------------------------------------------
        # Bare YouTube video ID
        # ------------------------------------------------------------

        if [[ "$part" =~ ^[A-Za-z0-9_-]{11}$ ]]; then
            URLS+=("https://youtu.be/$part")
            continue
        fi

        # ------------------------------------------------------------
        # youtu.be/<ID>
        # ------------------------------------------------------------

        if [[ "$part" =~ ^youtu\.be/([A-Za-z0-9_-]{11})$ ]]; then
            URLS+=("https://$part")
            continue
        fi

        # ------------------------------------------------------------
        # http(s)://youtu.be/<ID>
        # ------------------------------------------------------------

        if [[ "$part" =~ ^https?://youtu\.be/([A-Za-z0-9_-]{11}) ]]; then
            URLS+=("$part")
            continue
        fi

        # ------------------------------------------------------------
        # Other HTTP(S) URLs
        #
        # Keep these intact and let yt-dlp determine whether it supports
        # them.
        # ------------------------------------------------------------

        if [[ "$part" =~ ^https?:// ]]; then
            URLS+=("$part")
            continue
        fi

        # ------------------------------------------------------------
        # Reject anything that does not resemble a URL or video ID.
        # ------------------------------------------------------------

        echo "⚠️ Ignoring invalid URL/input: $part"

    done

done


# ============================================================================
# Validate URLs
# ============================================================================

if [[ "${#URLS[@]}" -eq 0 ]]; then
    echo
    echo "❌ No valid URLs specified."
    echo
    show_help
    exit 1
fi


# ============================================================================
# Execute batch
# ============================================================================

SUCCESSFUL=0
FAILED=0
FAILED_URLS=()


for URL in "${URLS[@]}"; do

    echo
    echo "▶ Downloading: $URL"

    if download "$URL"; then

        SUCCESSFUL=$((SUCCESSFUL + 1))

    else

        FAILED=$((FAILED + 1))
        FAILED_URLS+=("$URL")

        if [[ "$IGNORE_ERRORS" == "yes" ]]; then

            echo "⚠️ Download failed."
            echo "ℹ️ Ignoring error and continuing..."

        else

            echo
            echo "❌ Download failed: $URL"
            echo
            echo "⚠️ Batch stopped because --ignore-errors was not specified."

            exit 1

        fi

    fi

done


# ============================================================================
# Batch summary
# ============================================================================

echo
echo "────────────────────────────────────────"
echo "Batch completed."
printf '   Successful: %d\n' "$SUCCESSFUL"
printf '   Failed:     %d\n' "$FAILED"


if [[ "$FAILED" -gt 0 ]]; then

    echo
    echo "Failed URLs:"

    for URL in "${FAILED_URLS[@]}"; do
        echo "  - $URL"
    done

    if [[ "$IGNORE_ERRORS" == "yes" ]]; then
        echo
        echo "⚠️ Errors were ignored; batch processing continued."
    fi

    exit 1
fi


echo
echo "✅ All downloads completed successfully."

exit 0

