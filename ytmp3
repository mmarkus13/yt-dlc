#!/bin/bash

WRAPPER="$HOME/scripts/yt-dlp-wrapper"

if [[ ! -x "$WRAPPER" ]]; then
    echo "Error: yt-dlp-wrapper not found at $WRAPPER" >&2
    exit 1
fi

if [ "$#" -eq 0 ]; then
    read -r -p "Enter YouTube URL: " URL

    if [ -z "$URL" ]; then
        echo "Error: No URL provided" >&2
        exit 1
    fi

    set -- "$URL"
fi

exec "$WRAPPER" \
    --extract-audio \
    --audio-format mp3 \
    --audio-quality 0 \
    --no-part \
    "$@"
