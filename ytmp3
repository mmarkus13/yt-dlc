#!/bin/bash

YTDL="$HOME/scripts/yt-dlp"
CONFIG_DIR="$HOME/.config/yt-dlc"
CONFIG_FILE="$CONFIG_DIR/config"

if [[ ! -f "$YTDL" ]]; then
    echo "Error: yt-dlp not found at $YTDL" >&2
    exit 1
fi

mkdir -p "$CONFIG_DIR"

# Load existing configuration.
if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
fi

save_audio_config() {
    local enabled="$1"
    local directory="$2"
    local temp_file

    temp_file="$(mktemp)"

    if [[ -f "$CONFIG_FILE" ]]; then
        grep -vE '^(AUDIO_OUTPUT_ENABLED|AUDIO_OUTPUT_DIR)=' \
            "$CONFIG_FILE" > "$temp_file" || true
    fi

    printf 'AUDIO_OUTPUT_ENABLED=%q\n' "$enabled"

    if [[ -n "$directory" ]]; then
        printf 'AUDIO_OUTPUT_DIR=%q\n' "$directory"
    fi

    mv "$temp_file" "$CONFIG_FILE"
}

configure_output() {
    local default_dir="${AUDIO_OUTPUT_DIR:-$HOME/Music/YouTube}"
    local directory

    echo ""
    echo "🎵 MP3 download directory configuration"
    echo ""
    echo "Current setting:"
    if [[ "${AUDIO_OUTPUT_ENABLED:-0}" == "1" ]]; then
        echo "  $AUDIO_OUTPUT_DIR"
    else
        echo "  Not configured (uses the current directory)"
    fi
    echo ""

    read -r -p "Directory [$default_dir]: " directory
    directory="${directory:-$default_dir}"

    if [[ ! -d "$directory" ]]; then
        read -r -p "Directory does not exist. Create it? [Y/n] " answer
        answer="${answer:-Y}"

        if [[ "$answer" =~ ^[Yy]$ ]]; then
            if ! mkdir -p "$directory"; then
                echo "Error: Could not create directory: $directory" >&2
                return 1
            fi
        else
            echo "Configuration cancelled."
            return 1
        fi
    fi

    if [[ ! -w "$directory" ]]; then
        echo "Error: Directory is not writable: $directory" >&2
        return 1
    fi

    save_audio_config 1 "$directory"

    AUDIO_OUTPUT_ENABLED=1
    AUDIO_OUTPUT_DIR="$directory"

    echo ""
    echo "✓ MP3 downloads will now be saved to:"
    echo "  $AUDIO_OUTPUT_DIR"
    echo ""
}

reset_output() {
    save_audio_config 0 ""
    AUDIO_OUTPUT_ENABLED=0
    unset AUDIO_OUTPUT_DIR

    echo "✓ MP3 download directory preference removed."
    echo "Downloads will use the current directory."
}

# Handle wrapper-specific configuration commands.
case "${1:-}" in
    --configure-output)
        configure_output
        exit $?
        ;;
    --reset-output)
        reset_output
        exit $?
        ;;
esac

# First-run configuration.
if [[ -z "${AUDIO_OUTPUT_ENABLED+x}" ]]; then
    echo ""
    echo "🎵 yt-dlc"
    echo ""
    echo "No MP3 download directory preference has been configured."
    echo "Without a preference, downloads will use the current directory."
    echo ""

    read -r -p "Configure a default MP3 download directory now? [y/N] " answer

    if [[ "$answer" =~ ^[Yy]$ ]]; then
        configure_output || exit 1
    else
        save_audio_config 0 ""
        AUDIO_OUTPUT_ENABLED=0
        echo ""
        echo "✓ No preference saved."
        echo "Downloads will use the current directory."
        echo ""
    fi
fi

if [ "$#" -eq 0 ]; then
    read -r -p "Enter YouTube URL: " URL

    if [ -z "$URL" ]; then
        echo "Error: No URL provided" >&2
        exit 1
    fi

    set -- "$URL"
fi

# Temporary environment-variable override.
OUTPUT_DIR="${YOUTUBE_DOWNLOAD_PATH:-}"

if [[ -z "$OUTPUT_DIR" && "${AUDIO_OUTPUT_ENABLED:-0}" == "1" ]]; then
    OUTPUT_DIR="$AUDIO_OUTPUT_DIR"
fi

if [[ -n "$OUTPUT_DIR" ]]; then
    if [[ ! -d "$OUTPUT_DIR" ]]; then
        if ! mkdir -p "$OUTPUT_DIR"; then
            echo "Error: Could not create output directory: $OUTPUT_DIR" >&2
            exit 1
        fi
    fi

    if [[ ! -w "$OUTPUT_DIR" ]]; then
        echo "Error: Output directory is not writable: $OUTPUT_DIR" >&2
        exit 1
    fi
fi

ARGS=(
    --js-runtimes deno
    --extractor-args "youtube:player_client=web"
    --extract-audio
    --audio-format mp3
    --audio-quality 0
    --no-part
)

if [[ -n "$OUTPUT_DIR" ]]; then
    ARGS+=( -P "$OUTPUT_DIR" )
fi

exec "$YTDL" "${ARGS[@]}" "$@"
