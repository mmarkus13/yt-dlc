#!/bin/bash

YTDL="$HOME/scripts/yt-dlp"
OUTPUT_DIR="${YOUTUBE_DOWNLOAD_PATH:-$PWD}"

if [[ ! -f "$YTDL" ]]; then
    echo "Error: yt-dlp not found at $YTDL" >&2
    exit 1
fi

if [ "$#" -eq 0 ]; then
    read -r -p "Enter YouTube URL: " URL

    if [ -z "$URL" ]; then
        echo "Error: No URL provided" >&2
        exit 1
    fi

    set -- "$URL"
fi

COMMON_ARGS=(
    --js-runtimes deno
    -S res,ext:mp4,m4a
    --recode mp4
    --no-part
)

echo "▶ Downloading..."

if "$YTDL" \
    "${COMMON_ARGS[@]}" \
    "$@"
then
    exit 0
fi

echo ""
echo "⚠️ Download failed."
echo "Checking for a newer yt-dlp version..."

if "$YTDL" -U; then
    echo "✓ yt-dlp update check completed."
else
    echo "⚠️ yt-dlp could not be updated; continuing with the installed version."
fi

echo ""
echo "▶ Retrying..."

if "$YTDL" \
    "${COMMON_ARGS[@]}" \
    "$@"
then
    exit 0
fi

echo ""
echo "⚠️ Standard retry failed."
echo "▶ Retrying with YouTube web client..."

exec "$YTDL" \
    "${COMMON_ARGS[@]}" \
    --extractor-args "youtube:player_client=web" \
    "$@"
